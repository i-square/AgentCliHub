{
  "name": "AgentCliHub-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web console for updating Codex CLI / Claude Code via npm across local Windows and SSH hosts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@uiw/react-codemirror": "^4.25.12",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.64.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
